{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Omnier",
  "description": "Omnier is a CRM for Agents: companies, contacts, deals, and your workspace. Then connect in a few steps.",
  "theme": "mint",
  "favicon": "/favicon.ico",
  "logo": {
    "light": "/images/omnier-logo.png",
    "dark": "/images/omnier-logo.png",
    "href": "https://getomnier.com"
  },
  "colors": {
    "primary": "#D1D5DB",
    "light": "#D1D5DB",
    "dark": "#9CA3AF"
  },
  "background": {
    "light": "#F8F7F6",
    "dark": "#121212"
  },
  "fonts": {
    "family": "Inter, ui-sans-serif, system-ui, -apple-system, sans-serif"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "href": "https://getomnier.com",
          "icon": "globe"
        },
        {
          "anchor": "App",
          "href": "https://app.getomnier.com",
          "icon": "grid-2"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Omnier",
            "pages": [
              "index",
              "getting-started"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Getting started",
        "href": "/getting-started"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open app",
      "href": "https://app.getomnier.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/jessesorsa/docs",
      "website": "https://getomnier.com"
    }
  }
}