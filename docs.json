{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Omnier",
  "description": "The company brain for sales",
  "theme": "mint",
  "favicon": "/favicon.ico",
  "logo": {
    "light": "/images/omnier-logo.png",
    "dark": "/images/omnier-logo.png",
    "href": "https://getomnier.com"
  },
  "colors": {
    "primary": "#57534E",
    "light": "#A8A29E",
    "dark": "#0A0A0A"
  },
  "background": {
    "light": "#F8F7F6",
    "dark": "#121212"
  },
  "fonts": {
    "family": "Inter, ui-sans-serif, system-ui, -apple-system, sans-serif"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "href": "https://getomnier.com",
          "icon": "globe"
        },
        {
          "anchor": "App",
          "href": "https://app.getomnier.com",
          "icon": "grid-2"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "get-started/quick-start",
              "get-started/integrations",
              "get-started/use-cases"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/structure",
              "concepts/markdown-as-gtm",
              "concepts/self-updating-context",
              "concepts/mcp"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Quick start",
        "href": "/get-started/quick-start"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open app",
      "href": "https://app.getomnier.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "cursor",
      "vscode"
    ]
  },
  "redirects": [
    {
      "source": "/getting-started",
      "destination": "/get-started/quick-start"
    },
    {
      "source": "/connections",
      "destination": "/get-started/integrations"
    }
  ],
  "footer": {
    "socials": {
      "github": "https://github.com/jessesorsa/docs",
      "website": "https://getomnier.com"
    }
  }
}
